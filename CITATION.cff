url: "https://github.com/bibymaths/phoscrosstalk"

license: BSD-3-Clause

keywords:
  - bioinformatics
  - computational biology
  - phosphoproteomics
  - transcriptomics
  - proteomics
  - phosphorylation
  - systems biology
  - ordinary differential equations
  - optimization
  - JAX
  - Diffrax
  - kinase signaling

version: "0.1.0"

